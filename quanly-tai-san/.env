VITE_API_BASE_URL="https://localhost:7129/api"

# Google OAuth Client ID (https://console.cloud.google.com/apis/credentials)
VITE_GOOGLE_CLIENT_ID="95218852247-43a5381hhu7eltk5actltsmun13476cd.apps.googleusercontent.com"

# Bản đồ Mapbox: đặt VITE_MAPBOX_TOKEN trong .env.local (KHÔNG đặt ở đây — tệp này nằm trong
# kho mã công khai). Thiếu token thì bản đồ tự dùng OpenStreetMap. Tuỳ chọn thêm:
#   VITE_MAPBOX_STYLE=mapbox/streets-v12        (bản đồ tìm nhà)
#   VITE_MAPBOX_STYLE_LIGHT=mapbox/light-v11    (bản đồ tài sản)
